# Object Properties
:conductsResearch a owl:ObjectProperty ;
    rdfs:label "conductsResearch"@en ;
    rdfs:domain :Trường_Đại_học_Sài_Gòn ;
    rdfs:range  :Bài_báo_Khoa_học_và_báo_cáo_tham_luận ;
    rdfs:range  :Dự_án_nghiên_cứu_1 ;
    rdfs:range  :Dự_án_nghiên_cứu_2 ;
    rdfs:range  :Quyền_lợi_sinh_viên_NCKH ;
    rdfs:range  :Đề_tài_Nghiên_cứu_khoa_học_cấp_cơ_sở ;.

:hasDegree a owl:ObjectProperty ;
    rdfs:label "hasDegree"@en ;
    rdfs:domain :Trường_Đại_học_Sài_Gòn ;
    rdfs:range  :Cử_nhân ;
    rdfs:range  :Thạc_sĩ ;
    rdfs:range  :Tiến_sĩ ;.

:hasDepartment a owl:ObjectProperty ;
    rdfs:label "hasDepartment"@en ;
    rdfs:domain :Trường_Đại_học_Sài_Gòn ;
    rdfs:range  :Ban_lãnh_đạo ;
    rdfs:range  :Các_khoa_chuyên_môn ;
    rdfs:range  :Các_phòng_ban_chức_năng ;
    rdfs:range  :Các_trung_tâm_trực_thuộc ;
    rdfs:range  :Các_tổ_chức_đoàn_thể ;
    rdfs:range  :Khoa_Kinh_tế ;
    rdfs:range  :Khoa_Kỹ_thuật ;
    rdfs:range  :Khoa_Nghệ_thuật ;
    rdfs:range  :Đơn_vị_trực_thuộc ;.

:hasFaculty a owl:ObjectProperty ;
    rdfs:label "hasFaculty"@en ;
    rdfs:domain :Trường_Đại_học_Sài_Gòn ;
    rdfs:range  :Giảng_viên_1 ;
    rdfs:range  :Giảng_viên_2 ;.

:hasInternationalCooperation a owl:ObjectProperty ;
    rdfs:label "hasInternationalCooperation"@en ;
    rdfs:domain :Trường_Đại_học_Sài_Gòn ;
    rdfs:range  :Hợp_tác_quốc_tế ;
    rdfs:range  :Hợp_tác_quốc_tế_1 ;
    rdfs:range  :Hợp_tác_quốc_tế_2 ;.

:hasPurpose a owl:ObjectProperty ;
    rdfs:label "hasPurpose"@en ;
    rdfs:domain :Tạp_chí_Khoa_học_Đại_học_Sài_Gòn ;
    rdfs:range  :Tôn_chỉ__mục_đích_hoạt_động ;.

:hasStudent a owl:ObjectProperty ;
    rdfs:label "hasStudent"@en ;
    rdfs:domain :Trường_Đại_học_Sài_Gòn ;
    rdfs:range  :Sinh_viên_1 ;
    rdfs:range  :Sinh_viên_2 ;.

:hasSubmissionFormat a owl:ObjectProperty ;
    rdfs:label "hasSubmissionFormat"@en ;
    rdfs:domain :Tạp_chí_Khoa_học_Đại_học_Sài_Gòn ;
