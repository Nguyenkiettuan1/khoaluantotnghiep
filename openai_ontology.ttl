:includes a owl:ObjectProperty ;
    rdfs:label "includes"@en ;
    rdfs:domain :Hợp_tác_quốc_tế ;
    rdfs:range  :Các_chương_trình_hợp_tác__đào_tạo_quốc_tế ;
    rdfs:range  :Công_tác_đối_ngoại ;.

:offersProgram a owl:ObjectProperty ;
