
@prefix : <http://example.org/sgu#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

# Classes
:University a rdfs:Class .
:Degree a rdfs:Class .
:Program a rdfs:Class .
:Department a rdfs:Class .
:Research a rdfs:Class .
:InternationalCooperation a rdfs:Class .
:Journal a rdfs:Class .
:Student a rdfs:Class .
:Faculty a rdfs:Class .

# Properties
:hasDegree a rdf:Property ;
    rdfs:domain :University ;
    rdfs:range :Degree .

:offersProgram a rdf:Property ;
    rdfs:domain :University ;
    rdfs:range :Program .

:hasDepartment a rdf:Property ;
    rdfs:domain :University ;
    rdfs:range :Department .

:conductsResearch a rdf:Property ;
    rdfs:domain :University ;
    rdfs:range :Research .

:hasInternationalCooperation a rdf:Property ;
    rdfs:domain :University ;
    rdfs:range :InternationalCooperation .

:publishesIn a rdf:Property ;
    rdfs:domain :University ;
    rdfs:range :Journal .

:hasStudent a rdf:Property ;
    rdfs:domain :University ;
    rdfs:range :Student .

:hasFaculty a rdf:Property ;
    rdfs:domain :University ;
    rdfs:range :Faculty .

# Relationships
:University1 a :University ;
    :hasDegree :BachelorDegree, :MasterDegree, :DoctoralDegree ;
    :offersProgram :RegularProgram, :ContinuingEducationProgram, :HighQualityProgram ;
    :hasDepartment :Department1, :Department2, :Department3 ;
    :conductsResearch :ResearchProject1, :ResearchProject2 ;
    :hasInternationalCooperation :Cooperation1, :Cooperation2 ;
    :publishesIn :Journal1 ;
    :hasStudent :Student1, :Student2 ;
    :hasFaculty :Faculty1, :Faculty2 .

:BachelorDegree a :Degree .
:MasterDegree a :Degree .
:DoctoralDegree a :Degree .

:RegularProgram a :Program .
:ContinuingEducationProgram a :Program .
:HighQualityProgram a :Program .

:Department1 a :Department .
:Department2 a :Department .
:Department3 a :Department .

:ResearchProject1 a :Research .
:ResearchProject2 a :Research .

:Cooperation1 a :InternationalCooperation .
:Cooperation2 a :InternationalCooperation .

:Journal1 a :Journal .

:Student1 a :Student .
:Student2 a :Student .

:Faculty1 a :Faculty .
:Faculty2 a :Faculty .
