ttl
@prefix ex: <http://example.org/> .

ex:UniversityOfSaiGon a ex:University ;
    ex:hasName "Trường Đại học Sài Gòn" ;
    ex:hasDepartment ex:Department1, ex:Department2, ex:Department3 ;
    ex:hasPublication ex:JournalOfSaigonUniversity .

ex:Department1 a ex:Department ;
    ex:hasName "Khoa Giáo dục" ;
    ex:offersCourse ex:Course1, ex:Course2 .

ex:Course1 a ex:Course ;
    ex:hasName "Cử nhân Giáo dục" ;
    ex:hasSpecialization ex:Specialization1, ex:Specialization2 .

ex:Specialization1 a ex:Specialization ;
    ex:hasName "Sư phạm Mầm non" .

ex:Specialization2 a ex:Specialization ;
    ex:hasName "Sư phạm Tiểu học" .

ex:Department2 a ex:Department ;
    ex:hasName "Khoa Kinh tế" ;
    ex:offersCourse ex:Course3 .

ex:Course3 a ex:Course ;
    ex:hasName "Cử nhân Kinh doanh" ;
    ex:hasSpecialization ex:Specialization3 .

ex:Specialization3 a ex:Specialization ;
    ex:hasName "Quản trị Kinh doanh" .

ex:Department3 a ex:Department ;
    ex:hasName "Khoa Ngoại ngữ" ;
    ex:offersCourse ex:Course4 .

ex:Course4 a ex:Course ;
    ex:hasName "Cử nhân Ngôn ngữ Anh" .

ex:JournalOfSaigonUniversity a ex:Publication ;
    ex:hasName "Tạp chí Khoa học Đại học Sài Gòn" ;
    ex:hasISSN "1859-2038" ;
    ex:hasLink "http://sgj.edu.vn" .

ex:EducationSystem a ex:EducationSystem ;
    ex:hasMethod "Giáo dục thường xuyên" ;
    ex:hasLinkage "Liên kết đào tạo" .