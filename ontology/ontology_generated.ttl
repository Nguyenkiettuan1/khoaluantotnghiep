@prefix : <http://sgu.edu.vn/ontology#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Classes
:University a rdfs:Class .
:Department a rdfs:Class .
:TrainingProgram a rdfs:Class .
:Journal a rdfs:Class .
:Student a rdfs:Class .
:ResearchTopic a rdfs:Class .
:Scholarship a rdfs:Class .
:InternationalCooperation a rdfs:Class .
:Campus a rdfs:Class .
:QualityAssessment a rdfs:Class .

# Properties
:hasName a rdf:Property ;
    rdfs:domain :University ;
    rdfs:range xsd:string .

:hasType a rdf:Property ;
    rdfs:domain :University ;
    rdfs:range xsd:string .

:managedBy a rdf:Property ;
    rdfs:domain :University ;
    rdfs:range xsd:string .

:offersTrainingMethod a rdf:Property ;
    rdfs:domain :University ;
    rdfs:range xsd:string .

:hasTrainingField a rdf:Property ;
    rdfs:domain :University ;
    rdfs:range xsd:string .

:hasQualityCertification a rdf:Property ;
    rdfs:domain :University ;
    rdfs:range xsd:string .

:hasCampus a rdf:Property ;
    rdfs:domain :University ;
    rdfs:range :Campus .

:hasStudentHousing a rdf:Property ;
    rdfs:domain :University ;
    rdfs:range xsd:string .

:hasInternationalCooperation a rdf:Property ;
    rdfs:domain :University ;
    rdfs:range :InternationalCooperation .

:hasScholarship a rdf:Property ;
    rdfs:domain :University ;
    rdfs:range :Scholarship .

:hasResearchTopic a rdf:Property ;
    rdfs:domain :Student ;
    rdfs:range :ResearchTopic .

:hasJournal a rdf:Property ;
    rdfs:domain :University ;
    rdfs:range :Journal .

:hasTrainingProgram a rdf:Property ;
    rdfs:domain :University ;
    rdfs:range :TrainingProgram .

:hasDegreeLevel a rdf:Property ;
    rdfs:domain :TrainingProgram ;
    rdfs:range xsd:string .

:hasPublicationType a rdf:Property ;
    rdfs:domain :Journal ;
    rdfs:range xsd:string .

:hasPublicationRule a rdf:Property ;
    rdfs:domain :Journal ;
    rdfs:range xsd:string .

:hasTechnicalRequirement a rdf:Property ;
    rdfs:domain :Journal ;
    rdfs:range xsd:string .

:hasCitationStandard a rdf:Property ;
    rdfs:domain :Journal ;
    rdfs:range xsd:string .

:hasResearchBenefit a rdf:Property ;
    rdfs:domain :Student ;
    rdfs:range xsd:string .

:hasTrainingProgramType a rdf:Property ;
    rdfs:domain :TrainingProgram ;
    rdfs:range xsd:string .

:hasTrainingFieldDetail a rdf:Property ;
    rdfs:domain :TrainingProgram ;
    rdfs:range xsd:string .

# Relationships
:University :hasTrainingProgram :TrainingProgram .
:University :hasDepartment :Department .
:University :hasScholarship :Scholarship .
:University :hasInternationalCooperation :InternationalCooperation .
:University :hasQualityCertification :QualityAssessment .
:University :hasCampus :Campus .
:Student :hasResearchTopic :ResearchTopic .
:Journal :hasPublicationType :TrainingProgram .
:Journal :hasCitationStandard :Journal .
:TrainingProgram :hasDegreeLevel :University .