@prefix : <http://sgu.edu.vn/ontology#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:University a rdfs:Class .
:Department a rdfs:Class .
:TrainingProgram a rdfs:Class .
:Journal a rdfs:Class .
:Student a rdfs:Class .
:ResearchTopic a rdfs:Class .
:Scholarship a rdfs:Class .
:InternationalCooperation a rdfs:Class .
:Campus a rdfs:Class .
:QualityAssessment a rdfs:Class .

:hasDepartment a rdf:Property ;
    rdfs:domain :University ;
    rdfs:range :Department .

:offersTrainingProgram a rdf:Property ;
    rdfs:domain :University ;
    rdfs:range :TrainingProgram .

:hasStudent a rdf:Property ;
    rdfs:domain :University ;
    rdfs:range :Student .

:hasResearchTopic a rdf:Property ;
    rdfs:domain :Student ;
    rdfs:range :ResearchTopic .

:hasScholarship a rdf:Property ;
    rdfs:domain :University ;
    rdfs:range :Scholarship .

:hasInternationalCooperation a rdf:Property ;
    rdfs:domain :University ;
    rdfs:range :InternationalCooperation .

:hasCampus a rdf:Property ;
    rdfs:domain :University ;
    rdfs:range :Campus .

:hasQualityAssessment a rdf:Property ;
    rdfs:domain :University ;
    rdfs:range :QualityAssessment .

:hasJournal a rdf:Property ;
    rdfs:domain :University ;
    rdfs:range :Journal .

:hasTrainingMethod a rdf:Property ;
    rdfs:domain :TrainingProgram ;
    rdfs:range xsd:string .

:hasFieldOfStudy a rdf:Property ;
    rdfs:domain :TrainingProgram ;
    rdfs:range xsd:string .

:hasDegreeLevel a rdf:Property ;
    rdfs:domain :TrainingProgram ;
    rdfs:range xsd:string .

:hasPublicationType a rdf:Property ;
    rdfs:domain :Journal ;
    rdfs:range xsd:string .

:servesAudience a rdf:Property ;
    rdfs:domain :Journal ;
    rdfs:range xsd:string .

:hasPublicationGuidelines a rdf:Property ;
    rdfs:domain :Journal ;
    rdfs:range xsd:string .

:hasTechnicalRequirements a rdf:Property ;
    rdfs:domain :Journal ;
    rdfs:range xsd:string .

:hasCitationStandard a rdf:Property ;
    rdfs:domain :Journal ;
    rdfs:range xsd:string .

:hasStudentHousing a rdf:Property ;
    rdfs:domain :University ;
    rdfs:range xsd:string .

:hasCampusArea a rdf:Property ;
    rdfs:domain :Campus ;
    rdfs:range xsd:float .

:hasCollaborationDetails a rdf:Property ;
    rdfs:domain :InternationalCooperation ;
    rdfs:range xsd:string .

:hasScholarshipConditions a rdf:Property ;
    rdfs:domain :Scholarship ;
    rdfs:range xsd:string .

:hasResearchParticipationConditions a rdf:Property ;
    rdfs:domain :Student ;
    rdfs:range xsd:string .

:hasResearchBenefits a rdf:Property ;
    rdfs:domain :Student ;
    rdfs:range xsd:string .

:hasResearchPublicationOpportunity a rdf:Property ;
    rdfs:domain :Student ;
    rdfs:range xsd:string .

:hasQualityAssessmentDate a rdf:Property ;
    rdfs:domain :QualityAssessment ;
    rdfs:range xsd:date .