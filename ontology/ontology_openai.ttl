:hasDepartment a rdf:Property ;
    rdfs:domain :Trường Đại học Sài Gòn ;
    rdfs:range :Ban lãnh đạo, :Các khoa chuyên môn, :Các phòng ban chức năng, :Các trung tâm trực thuộc, :Các tổ chức đoàn thể, :Khoa Kinh tế, :Khoa Kỹ thuật, :Khoa Nghệ thuật, :Đơn vị trực thuộc .

:conductsResearch a rdf:Property ;
    rdfs:domain :Trường Đại học Sài Gòn ;
    rdfs:range :Bài báo Khoa học và báo cáo tham luận, :Dự án nghiên cứu 1, :Dự án nghiên cứu 2, :Quyền lợi sinh viên NCKH, :Đề tài Nghiên cứu khoa học cấp cơ sở .

:hasInternationalCooperation a rdf:Property ;
    rdfs:domain :Trường Đại học Sài Gòn ;
    rdfs:range :Hợp tác quốc tế, :Hợp tác quốc tế 1, :Hợp tác quốc tế 2 .

:publishesIn a rdf:Property ;
    rdfs:domain :Trường Đại học Sài Gòn ;
    rdfs:range :Tạp chí Khoa học, :Tạp chí Khoa học Đại học Sài Gòn .

:hasStudent a rdf:Property ;
    rdfs:domain :Trường Đại học Sài Gòn ;
    rdfs:range :Sinh viên 1, :Sinh viên 2 .

:hasFaculty a rdf:Property ;
    rdfs:domain :Trường Đại học Sài Gòn ;
    rdfs:range :Giảng viên 1, :Giảng viên 2 .

:includes a rdf:Property ;
    rdfs:domain :Hợp tác quốc tế ;
    rdfs:range :Các chương trình hợp tác, đào tạo quốc tế, :Công tác đối ngoại .

:hasPurpose a rdf:Property ;
    rdfs:domain :Tạp chí Khoa học Đại học Sài Gòn ;
    rdfs:range :Tôn chỉ, mục đích hoạt động .

:hasSubmissionGuidelines a rdf:Property ;
    rdfs:domain :Tạp chí Khoa học Đại học Sài Gòn ;
    rdfs:range :Quy định chung về bài báo khoa học .

:hasSubmissionFormat a rdf:Property ;
    rdfs:domain :Tạp chí Khoa học Đại học Sài Gòn ;
    rdfs:range :Thể lệ gửi bài đăng .

