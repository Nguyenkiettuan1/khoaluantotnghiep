# Auto Evaluation Pipeline Environment Configuration
# Copy this file to .env and update with your actual values

# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Neo4j Database Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# Optional: Database names (defaults will be used if not specified)
# NEO4J_DATABASE_DEEPSEEK=deepseek
# NEO4J_DATABASE_GEMINI=gemini  
# NEO4J_DATABASE_OPENAI=openai
