MERGE (f17:Faculty {name: "Khoa Giáo dục Quốc phòng & An ninh - Giáo dục Thể chất", description: "Đào tạo giáo dục quốc phòng và thể chất"})

// Đơn vị trực thuộc
MERGE (i1:Department {name: "Viện Khoa học Dữ liệu và Trí tuệ nhân tạo", description: "Nghiên cứu và đào tạo về AI và khoa học dữ liệu"})
MERGE (i2:Department {name: "Viện Nghiên cứu Môi trường - Sức khỏe", description: "Nghiên cứu về môi trường và sức khỏe"})
