MERGE (u:University {name: "Trường Đại học Sài Gòn", description: "Trường Đại học công lập trực thuộc UBND TP. Hồ Chí Minh, đào tạo đa ngành từ trình độ đại học đến sau đại học với các phương thức chính quy và giáo dục thường xuyên"})

// Ban lãnh đạo
MERGE (d1:Department {name: "Đảng ủy", description: "Ban lãnh đạo chính trị của trường"})
MERGE (d2:Department {name: "Hiệu trưởng", description: "Người đứng đầu nhà trường"})
MERGE (d3:Department {name: "Phó Hiệu trưởng", description: "Các phó hiệu trưởng phụ trách các lĩnh vực khác nhau"})
MERGE (d4:Department {name: "Hội đồng trường", description: "Cơ quan quản trị cao nhất của trường"})

// Tổ chức đoàn thể
MERGE (d5:Department {name: "Công đoàn", description: "Tổ chức đại diện cho quyền lợi của cán bộ, giảng viên"})
MERGE (d6:Department {name: "Đoàn Thanh niên", description: "Tổ chức thanh niên của trường"})
MERGE (d7:Department {name: "Hội Sinh viên", description: "Tổ chức đại diện cho sinh viên"})

// Phòng ban chức năng
MERGE (d8:Department {name: "Phòng Đào tạo", description: "Phụ trách công tác đào tạo chính quy"})
MERGE (d9:Department {name: "Phòng Tổ chức - Cán bộ", description: "Quản lý nhân sự và tổ chức"})
MERGE (d10:Department {name: "Văn phòng", description: "Phụ trách hành chính tổng hợp"})
MERGE (d11:Department {name: "Phòng Kế hoạch - Tài chính", description: "Quản lý tài chính và kế hoạch phát triển"})
MERGE (d12:Department {name: "Phòng Công tác sinh viên", description: "Quản lý các hoạt động sinh viên"})
MERGE (d13:Department {name: "Phòng Quản lý khoa học", description: "Quản lý hoạt động nghiên cứu khoa học"})
MERGE (d14:Department {name: "Phòng Đào tạo sau đại học", description: "Quản lý đào tạo thạc sĩ, tiến sĩ"})
MERGE (d15:Department {name: "Phòng Thanh tra - Pháp chế", description: "Thực hiện công tác thanh tra và pháp chế"})
MERGE (d16:Department {name: "Phòng Khảo thí & Đảm bảo chất lượng", description: "Quản lý khảo thí và chất lượng đào tạo"})
MERGE (d17:Department {name: "Ban Quản lý Dự án & Xây dựng", description: "Quản lý các dự án xây dựng cơ sở vật chất"})
MERGE (d18:Department {name: "Phòng Hợp tác quốc tế & Doanh nghiệp", description: "Quản lý hợp tác quốc tế và doanh nghiệp"})
MERGE (d19:Department {name: "Phòng Thiết bị", description: "Quản lý trang thiết bị giảng dạy"})
MERGE (d20:Department {name: "Phòng Giáo dục thường xuyên", description: "Quản lý đào tạo không chính quy"})

// Các trung tâm trực thuộc
MERGE (c1:Department {name: "Trung tâm Khảo thí", description: "Tổ chức các kỳ thi và đánh giá"})
MERGE (c2:Department {name: "Trung tâm Đào tạo quốc tế", description: "Đào tạo các chương trình quốc tế"})
MERGE (c3:Department {name: "Trung tâm Hỗ trợ sinh viên", description: "Hỗ trợ toàn diện cho sinh viên"})
MERGE (c4:Department {name: "Trung tâm Học liệu", description: "Quản lý tài liệu học tập"})
MERGE (c5:Department {name: "Trung tâm Công nghệ thông tin", description: "Quản lý hệ thống CNTT của trường"})
MERGE (c6:Department {name: "Trung tâm Ngoại ngữ", description: "Đào tạo và bồi dưỡng ngoại ngữ"})
MERGE (c7:Department {name: "Trung tâm Tuyển sinh & Truyền thông", description: "Tuyển sinh và truyền thông đại chúng"})
MERGE (c8:Department {name: "Trung tâm Ký túc xá", description: "Quản lý ký túc xá sinh viên"})
MERGE (c9:Department {name: "Trạm Y tế", description: "Chăm sóc sức khỏe cho cán bộ và sinh viên"})

// Các khoa chuyên môn
MERGE (f1:Faculty {name: "Khoa Giáo dục Mầm non", description: "Đào tạo giáo viên mầm non"})
