MERGE (f11:Faculty {name: "Khoa Quản trị Kinh doanh", description: "Đào tạo quản trị kinh doanh"})
MERGE (f12:Faculty {name: "Khoa Tài chính - Kế toán", description: "Đào tạo tài chính và kế toán"})
MERGE (f13:Faculty {name: "Khoa Văn hóa và Du lịch", description: "Đào tạo văn hóa và du lịch"})
