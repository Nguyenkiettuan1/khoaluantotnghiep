MERGE (i4:Department {name: "Trường Trung học Thực hành Sài Gòn", description: "Trường thực hành bậc trung học"})
MERGE (i5:Department {name: "Trường Tiểu học Thực hành Sài Gòn", description: "Trường thực hành bậc tiểu học"})

